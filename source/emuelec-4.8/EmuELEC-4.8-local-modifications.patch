@@ -45,6 +45,15 @@ RACONF="/storage/.config/retroarch/retroarch.cfg"
 NETPLAY="No"
 RABIN="retroarch"
 
+# The preserved EmuELEC 4.6 user config may contain the old resource-style
+# BIOS path ":/roms/bios". On the native H728/aarch64 RetroArch build this
+# resolves relative to /usr/bin and PCSX-ReARMed falls back to HLE BIOS.
+# Migrate only that legacy value and leave user-selected custom paths alone.
+if grep -aq "sun55i-h728" /proc/device-tree/compatible 2>/dev/null && \
+   grep -q '^system_directory = ":/roms/bios"$' "${RACONF}" 2>/dev/null; then
+    sed -i 's|^system_directory = ":/roms/bios"$|system_directory = "/storage/roms/bios"|' "${RACONF}"
+fi
+
 init_game
 
