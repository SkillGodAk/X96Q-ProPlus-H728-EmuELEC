@@ -7,37 +7,88 @@
 # Source predefined functions and variables
 . /etc/profile
 
-# DO NOT modify this file. 
+# DO NOT modify this file.
 
 # It seems some slow SDcards have a problem creating the symlink on time :/
 CONFIG_FLASH="/flash/config.ini"
 VIDEO_FILE="/storage/.config/EE_VIDEO_MODE"
 VIDEO_MODE="/sys/class/display/mode"
 
+is_h728=false
+if [[ "$EE_DEVICE" == "H728" ]] || grep -aq "sun55i-h728" /proc/device-tree/compatible 2>/dev/null; then
+  is_h728=true
+fi
+
 
 
-# If the video-mode is contained in flash config.
+# Select the video mode. H728 must not inherit the legacy Amlogic vout
+# priority: a leftover /flash/config.ini vout can silently pin HDMI to 1080p
+# and override EmulationStation's newly selected Auto/DRM resolution.
 DEFE=""
+if ${is_h728}; then
+  # H728's ES setting is authoritative. The external file remains a fallback
+  # for first boot / systems without an ES setting; it cannot mask a UI change.
+  DEFE=$(get_ee_setting ee_videomode)
+  if [[ -z "${DEFE}" && -f "${VIDEO_FILE}" ]]; then
+    DEFE=$(cat "${VIDEO_FILE}")
+  fi
+  [[ "${DEFE}" == "Custom" ]] && DEFE="auto"
+else
+  # Preserve the original Amlogic/other-platform setting priority exactly.
+  if [ -z "${DEFE}" ]; then
+    CFG_VAL=$(get_config_value "${CONFIG_FLASH}" "vout")
+    if [[ ! -z "${CFG_VAL}" ]]; then
+      DEFE="${CFG_VAL}"
+    fi
+  fi
 
-# FLASH CONFIG hdmimode takes priority 1.
-if [ -z "${DEFE}" ]; then
-  CFG_VAL=$(get_config_value "${CONFIG_FLASH}" "vout")
-  if [[ ! -z "${CFG_VAL}" ]]; then
-    DEFE="${CFG_VAL}"
+  if [[ -z "${DEFE}" && -f "${VIDEO_FILE}" ]]; then
+    DEFE=$(cat ${VIDEO_FILE})
   fi
-fi
 
-# Check for EE_VIDEO_MODE override 2nd.
-if [[ -z "${DEFE}" && -f "${VIDEO_FILE}" ]]; then
-  DEFE=$(cat ${VIDEO_FILE})
+  if [ -z "${DEFE}" ]; then
+    DEFE=$(get_ee_setting ee_videomode)
+    if [ "${DEFE}" == "Custom" ]; then
+      DEFE=$(cat ${VIDEO_MODE})
+    fi
+  fi
 fi
 
-# 3rd check ES for it's preferred resolution.
-if [ -z "${DEFE}" ]; then
-  DEFE=$(get_ee_setting ee_videomode)
-  if [ "${DEFE}" == "Custom" ]; then
-      DEFE=$(cat ${VIDEO_MODE})
+# H728 uses a platform-specific DRM/KMS backend, just as H3 uses h3disp.
+# The default entry contains no hardcoded video= mode. On every boot, auto or
+# the user's ee_videomode is validated against HDMI and exported as a DRM mode
+# index for patched SDL/KMSDRM and RetroArch. No /flash write or reboot needed.
+if ${is_h728}; then
+  [[ -z "${DEFE}" ]] && DEFE="auto"
+
+  H728_MODE_OUT=$(h728-display-mode set "${DEFE}" 2>>/emuelec/logs/h728-display-mode.log)
+  H728_MODE_RC=$?
+
+  # A saved mode may be valid on the previous TV but not on the newly
+  # connected one. Keep the user's saved preference, but use Auto for this
+  # boot rather than falling back to SDL's largest-mode heuristic.
+  if [ "${H728_MODE_RC}" -ne 0 ] && [ "${DEFE}" != "auto" ]; then
+    echo "H728 display backend rejected '${DEFE}' rc=${H728_MODE_RC}; trying auto" >> /emuelec/logs/h728-display-mode.log
+    H728_MODE_OUT=$(h728-display-mode set auto 2>>/emuelec/logs/h728-display-mode.log)
+    H728_MODE_RC=$?
   fi
+
+  if [ "${H728_MODE_RC}" -ne 0 ]; then
+    rm -f /var/run/drmMode
+    echo "H728 display backend could not resolve a safe mode; using stock KMS fallback" >> /emuelec/logs/h728-display-mode.log
+    exit 0
+  fi
+
+  case "${H728_MODE_OUT}" in
+    H728_MODE_SET=*)
+      exit 0
+      ;;
+    *)
+      rm -f /var/run/drmMode
+      echo "H728 display backend returned unexpected output: ${H728_MODE_OUT}; using stock KMS fallback" >> /emuelec/logs/h728-display-mode.log
+      exit 0
+      ;;
+  esac
 fi
 
 # Set video mode, this has to be done before starting ES
