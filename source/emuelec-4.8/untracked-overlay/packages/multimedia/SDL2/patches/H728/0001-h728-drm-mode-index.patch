+/* H728/EmuELEC: selected DRM mode index shared by SDL and RetroArch.
+   Missing or invalid state means "use normal SDL KMSDRM selection". */
+static int KMSDRM_GetConfiguredModeIndex(drmModeConnector *connector)
+{
+    FILE *fd;
+    int mode_index = -1;
+
+    fd = fopen("/var/run/drmMode", "r");
+    if (fd) {
+        int configured_index;
+        if (fscanf(fd, "%d", &configured_index) == 1 &&
+            configured_index >= 0 && configured_index < connector->count_modes) {
+            mode_index = configured_index;
+        }
+        fclose(fd);
+    }
+
+    return mode_index;
+}
