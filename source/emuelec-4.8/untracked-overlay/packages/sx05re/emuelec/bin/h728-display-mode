#!/bin/bash
# H728 display-mode backend for EmuELEC.
# Uses mainline DRM/KMS mode indexes shared by SDL/KMSDRM and RetroArch.
# It never writes Android/eMMC or /flash.

set -u

SELF="${0##*/}"
STATE_DIR="/var/run/h728-display-mode"
MODE_FILE="/var/run/drmMode"

is_h728() {
    grep -aq "sun55i-h728" /proc/device-tree/compatible 2>/dev/null
}

connector_path() {
    local c
    for c in /sys/class/drm/card*-HDMI-A-*; do
        [ -e "$c/status" ] || continue
        if [ "$(cat "$c/status" 2>/dev/null)" = "connected" ]; then
            printf '%s\n' "$c"
            return 0
        fi
    done
    return 1
}

connector_name() {
    local p
    p="$(connector_path)" || return 1
    basename "$p" | sed -E 's/^card[0-9]+-//'
}

drm_modes() {
    # Output: INDEX<TAB>NAME<TAB>REFRESH for the connected HDMI connector.
    command -v modetest >/dev/null 2>&1 || return 1
    modetest -M sun4i-drm -c 2>/dev/null | awk '
        /^[[:space:]]+modes:/ {inm=1; next}
        inm && /^[[:space:]]+props:/ {exit}
        inm && /^[[:space:]]+#[0-9]+[[:space:]]/ {
            idx=$1
            sub(/^#/, "", idx)
            print idx "\t" $2 "\t" $3
        }
    '
}

legacy_token() {
    local name="$1" hz="$2"
    case "${name}@${hz}" in
        3840x2160@60) echo "2160p60hz" ;;
        3840x2160@50) echo "2160p50hz" ;;
        3840x2160@30) echo "2160p30hz" ;;
        1920x1080@120) echo "1920x1080p120hz" ;;
        1920x1080@60) echo "1080p60hz" ;;
        1920x1080@50) echo "1080p50hz" ;;
        1920x1080@30) echo "1080p30hz" ;;
        1920x1080@24) echo "1080p24hz" ;;
        1280x720@60) echo "720p60hz" ;;
        1280x720@50) echo "720p50hz" ;;
        720x576@50) echo "576p50hz" ;;
        720x480@60) echo "480p60hz" ;;
        *) echo "${name}p${hz}hz" ;;
    esac
}

list_modes() {
    local idx name refresh hz
    drm_modes | while IFS=$'\t' read -r idx name refresh; do
        [ -n "$name" ] || continue
        case "$name" in *i) continue ;; esac
        hz="$(awk -v r="$refresh" 'BEGIN {printf "%d", r + 0.5}')"
        legacy_token "$name" "$hz"
    done | awk '!seen[$0]++'
}

normalize_mode() {
    local raw="${1:-}" body w h hz
    raw="${raw// /}"
    raw="${raw,,}"
    raw="${raw%hz}"

    case "$raw" in
        2160p*) w=3840; h=2160; hz="${raw#2160p}" ;;
        1080p*) w=1920; h=1080; hz="${raw#1080p}" ;;
        720p*)  w=1280; h=720; hz="${raw#720p}" ;;
        576p*)  w=720; h=576; hz="${raw#576p}" ;;
        480p*)  w=720; h=480; hz="${raw#480p}" ;;
        *x*p*)
            w="${raw%%x*}"
            body="${raw#*x}"
            h="${body%%p*}"
            hz="${body#*p}"
            ;;
        *) return 2 ;;
    esac

    [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ && "$hz" =~ ^[0-9]+$ ]] || return 2
    printf '%sx%s@%s\n' "$w" "$h" "$hz"
}

mode_index_for() {
    local want="$1" idx name refresh hz
    local wh="${want%@*}" wr="${want#*@}"
    while IFS=$'\t' read -r idx name refresh; do
        case "$name" in *i) continue ;; esac
        hz="$(awk -v r="$refresh" 'BEGIN {printf "%d", r + 0.5}')"
        if [ "$name" = "$wh" ] && [ "$hz" = "$wr" ]; then
            printf '%s\n' "$idx"
            return 0
        fi
    done < <(drm_modes)
    return 1
}

drm_preferred_resolution() {
    # Prefer an explicit DRM preferred mode when the driver exposes one.
    modetest -M sun4i-drm -c 2>/dev/null | awk '
        /^[[:space:]]+modes:/ {inm=1; next}
        inm && /^[[:space:]]+props:/ {exit}
        inm && /^[[:space:]]+#[0-9]+[[:space:]]/ && /type:.*preferred/ {
            print $2
            exit
        }
    '
}

edid_preferred_mode() {
    # EDID DTD1 encodes native geometry AND timing. Do not discard refresh.
    local p raw w h hb vb clock hz
    local -a b
    p="$(connector_path)" || return 1
    [ -r "$p/edid" ] || return 1
    raw="$(od -An -v -tu1 -N128 "$p/edid" 2>/dev/null | tr '\n' ' ')" || return 1
    read -r -a b <<< "$raw"
    [ "${#b[@]}" -ge 128 ] || return 1
    [ $(( b[24] & 2 )) -ne 0 ] || return 1
    [ $(( b[71] & 128 )) -eq 0 ] || return 1
    clock=$(( (b[54] + (b[55] << 8)) * 10000 ))
    w=$(( b[56] + ((b[58] & 240) << 4) ))
    h=$(( b[59] + ((b[61] & 240) << 4) ))
    hb=$(( b[57] + ((b[58] & 15) << 8) ))
    vb=$(( b[60] + ((b[61] & 15) << 8) ))
    [ "$clock" -gt 0 ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
    hz=$(( (clock + ((w + hb) * (h + vb) / 2)) / ((w + hb) * (h + vb)) ))
    [ "$hz" -gt 0 ] || return 1
    printf '%sx%s@%s\n' "$w" "$h" "$hz"
}

edid_preferred_resolution() {
    local mode
    mode="$(edid_preferred_mode)" || return 1
    printf '%s\n' "${mode%@*}"
}

pick_mode_for_resolution() {
    local target="$1" limit="${2:-0}" idx name refresh hz best=""
    while IFS=$'\t' read -r idx name refresh; do
        [ "$name" = "$target" ] || continue
        case "$name" in *i) continue ;; esac
        hz="$(awk -v r="$refresh" 'BEGIN {printf "%d", r + 0.5}')"
        [ "$hz" -gt 0 ] || continue
        if [ "$limit" -gt 0 ] && [ "$hz" -gt "$limit" ]; then continue; fi
        if [ -z "$best" ] || [ "$hz" -gt "$best" ]; then best="$hz"; fi
    done < <(drm_modes)

    [ -n "$best" ] && { printf '%s@%s\n' "$target" "$best"; return 0; }
    return 1
}

safe_auto_fallback() {
    # Batocera also treats 1080p60 as a compatibility-safe fallback.
    # Use it only when no preferred/native resolution can be established.
    local idx name refresh hz area best_area=-1 best_hz=-1 best_mode=""

    if mode_index_for "1920x1080@60" >/dev/null 2>&1; then
        printf '1920x1080@60\n'
        return 0
    fi

    while IFS=$'\t' read -r idx name refresh; do
        case "$name" in *i) continue ;; esac
        hz="$(awk -v r="$refresh" 'BEGIN {printf "%d", r + 0.5}')"
        [ "$hz" -le 60 ] || continue
        area="$(awk -v n="$name" 'BEGIN {split(n,a,"x"); print a[1]*a[2]}')"
        if [ "$area" -gt "$best_area" ] || { [ "$area" -eq "$best_area" ] && [ "$hz" -gt "$best_hz" ]; }; then
            best_area="$area"
            best_hz="$hz"
            best_mode="${name}@${hz}"
        fi
    done < <(drm_modes)

    [ -n "$best_mode" ] || return 1
    printf '%s\n' "$best_mode"
}

auto_mode() {
    local native="" preferred="" chosen=""
    native="$(edid_preferred_mode 2>/dev/null || true)"
    if [ -n "$native" ]; then
        if mode_index_for "$native" >/dev/null 2>&1; then
            printf '%s\n' "$native"
            return 0
        fi
        chosen="$(pick_mode_for_resolution "${native%@*}" "${native#*@}")" && {
            printf '%s\n' "$chosen"
            return 0
        }
    fi

    # An explicit DRM preferred mode is the next choice, not list index zero.
    preferred="$(modetest -M sun4i-drm -c 2>/dev/null | awk '
        /^[[:space:]]+modes:/ {inm=1; next}
        inm && /^[[:space:]]+props:/ {exit}
        inm && /^[[:space:]]+#[0-9]+[[:space:]]/ && /type:.*preferred/ {
            if ($2 !~ /i$/) {printf "%s@%d\n", $2, $3 + 0.5; exit}
        }
    ')"
    if [ -n "$preferred" ] && mode_index_for "$preferred" >/dev/null 2>&1; then
        printf '%s\n' "$preferred"
        return 0
    fi
    safe_auto_fallback
}

resolve_mode() {
    local req="${1:-auto}" mode
    if [ -z "$req" ] || [ "${req,,}" = "auto" ]; then
        mode="$(auto_mode)" || return 3
    else
        mode="$(normalize_mode "$req")" || return 2
    fi
    mode_index_for "$mode" >/dev/null || return 4
    printf '%s\n' "$mode"
}

record_selection() {
    local req="$1" mode="$2" idx="$3" conn edid_sha="unavailable" p
    conn="$(connector_name 2>/dev/null || true)"
    p="$(connector_path 2>/dev/null || true)"
    if [ -n "$p" ] && [ -r "$p/edid" ]; then
        edid_sha="$(sha256sum "$p/edid" | awk '{print $1}')"
    fi
    mkdir -p "$STATE_DIR"
    {
        printf 'requested=%s\n' "$req"
        printf 'edid_native=%s\n' "$(edid_preferred_mode 2>/dev/null || true)"
        printf 'resolved=%s\n' "$mode"
        printf 'mode_index=%s\n' "$idx"
        printf 'connector=%s\n' "$conn"
        printf 'edid_sha256=%s\n' "$edid_sha"
        printf 'timestamp=%s\n' "$(date '+%F %T')"
    } > "${STATE_DIR}/last-selection"
}

set_mode() {
    local req="${1:-auto}" mode idx tmp
    mode="$(resolve_mode "$req")" || return $?
    idx="$(mode_index_for "$mode")" || return 4

    mkdir -p /var/run
    tmp="${MODE_FILE}.h728.$$"
    printf '%s\n' "$idx" > "$tmp" || return 5
    [ "$(cat "$tmp")" = "$idx" ] || { rm -f "$tmp"; return 5; }
    mv "$tmp" "$MODE_FILE" || { rm -f "$tmp"; return 5; }

    record_selection "$req" "$mode" "$idx"
    printf 'H728_MODE_SET=%s INDEX=%s\n' "$mode" "$idx"
}

current_mode() {
    local idx cur name refresh hz
    [ -r "$MODE_FILE" ] || return 1
    idx="$(cat "$MODE_FILE" 2>/dev/null)"
    [[ "$idx" =~ ^[0-9]+$ ]] || return 1

    while IFS=$'\t' read -r cur name refresh; do
        [ "$cur" = "$idx" ] || continue
        case "$name" in *i) return 1 ;; esac
        hz="$(awk -v r="$refresh" 'BEGIN {printf "%d", r + 0.5}')"
        legacy_token "$name" "$hz"
        return 0
    done < <(drm_modes)
    return 1
}

usage() {
    echo "usage: $SELF list|resolve [MODE]|index [MODE]|current|set [MODE]"
}

is_h728 || { echo "$SELF: H728 only" >&2; exit 64; }

case "${1:-}" in
    list) list_modes ;;
    resolve) resolve_mode "${2:-auto}" ;;
    index)
        mode="$(resolve_mode "${2:-auto}")" || exit $?
        mode_index_for "$mode"
        ;;
    current) current_mode ;;
    set) set_mode "${2:-auto}" ;;
    *) usage; exit 64 ;;
esac
